---
layout: layouts/base.njk
pagination:
  data: locations.publishedPages
  size: 1
  alias: local
permalink: "{{ local.path }}"
---

{% include "partials/breadcrumbs.njk" %}
<section class="page-hero">
  <div class="container page-hero__grid">
    <div><p class="eyebrow">{{ local.content.eyebrow }}</p><h1>{{ local.content.h1 }}</h1></div>
    <p class="page-hero__copy">{{ local.content.intro }}</p>
  </div>
</section>

{% if local.type == "city" %}
  <section class="section">
    <div class="container">
      {% set eyebrow = "Serviços disponíveis" %}{% set heading = "Escolha o formato da sua comemoração." %}{% set copy = "Consulte o tema, a composição do kit e a disponibilidade para a sua data." %}
      {% include "partials/section-heading.njk" %}
      <div class="audience-grid">
        {% for service in local.content.services %}
          <article class="audience-card">
            <p class="eyebrow">{{ local.name }} · {{ local.state }}</p>
            <h2><a href="{{ service.path | url }}">{{ service.name }}</a></h2>
            <p>{{ service.description }}</p>
            <a class="text-link" href="{{ service.path | url }}">Ver {{ service.name }} <span aria-hidden="true">→</span></a>
          </article>
        {% endfor %}
      </div>
      <p style="margin-top:1.5rem"><a class="text-link" href="{{ '/temas/' | url }}">Veja temas do acervo e consulte disponibilidade em {{ local.name }} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
{% endif %}

<section class="section section--lilac">
  <div class="container split">
    <div class="split__content">
      <p class="eyebrow">Informações confirmadas</p>
      <h2>{{ local.content.detailTitle }}</h2>
      <p>{{ local.content.detailText }}</p>
      {% if local.type == "neighborhood" or local.citySlug == "joinville" %}
        <address><a href="{{ site.mapsUrl }}" target="_blank" rel="noopener">{{ site.address.display }}</a></address>
      {% else %}
        <p>O endereço de retirada divulgado fica em Joinville, no bairro Paranaguamirim.</p>
        <address><a href="{{ site.mapsUrl }}" target="_blank" rel="noopener">{{ site.address.display }}</a></address>
      {% endif %}
      {% if local.content.pickupNeighborhoodPath %}
        <p><a class="text-link" href="{{ local.content.pickupNeighborhoodPath | url }}">{{ local.content.pickupLabel }} <span aria-hidden="true">→</span></a></p>
      {% elif local.type == "city" %}
        <p><a class="text-link" href="{{ site.mapsUrl }}" target="_blank" rel="noopener">{{ local.content.pickupLabel }} <span aria-hidden="true">↗</span></a></p>
      {% endif %}
    </div>
    <div>
      <div class="comparison-card">
        <p class="eyebrow">Como consultar</p>
        <h2>Envie os dados da sua festa.</h2>
        <ul class="check-list">
          <li>Cidade e bairro do evento.</li>
          <li>Data da comemoração.</li>
          <li>Serviço ou tema que você procura.</li>
        </ul>
        <p>A Lela confirma disponibilidade, retirada e eventual entrega pelo WhatsApp.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  {% if local.type == "neighborhood" %}
  <div class="container">
    {% set eyebrow = "Serviços relacionados" %}{% set heading = "Veja como a decoração funciona." %}{% set copy = "Conheça as opções e confirme os detalhes diretamente com a Lela." %}
    {% include "partials/section-heading.njk" %}
    <div class="audience-grid">
      {% for service in local.content.services %}
        <article class="audience-card">
          <h2><a href="{{ service.path | url }}">{{ service.name }}</a></h2>
          <p>{{ service.description }}</p>
          <a class="text-link" href="{{ service.path | url }}">Saiba mais <span aria-hidden="true">→</span></a>
        </article>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>

{% if local.content.faqs.length %}
  <section class="section section--tight section--lilac">
    <div class="container" style="max-width:900px">
      {% set eyebrow = "Perguntas frequentes" %}{% set heading = "Informações para planejar com tranquilidade." %}{% set copy = "As condições finais são confirmadas no atendimento." %}
      {% include "partials/section-heading.njk" %}
      {% set faqs = local.content.faqs %}
      {% include "partials/faq-list.njk" %}
    </div>
  </section>
{% endif %}

{% set message = local.content.whatsappMessage %}
{% set label = local.content.whatsappLabel %}
{% include "partials/whatsapp-cta.njk" %}
