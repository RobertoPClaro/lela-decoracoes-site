{% include "partials/breadcrumbs.njk" %}
<section class="page-hero">
  <div class="container page-hero__grid">
    <div><p class="eyebrow">Tema do acervo · {{ theme.name }}</p><h1>{{ theme.h1 }}</h1></div>
    <p class="page-hero__copy">{{ theme.intro }}</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split__visual theme-page__hero-image">
      {% set item = theme.heroImage %}{% set imageClass = "" %}{% set imageSizes = "(min-width: 900px) 42vw, 92vw" %}{% set imageLoading = "eager" %}{% set imageFetchPriority = "high" %}{% set imagePreset = "hero" %}{% include "partials/image.njk" %}
      <p class="portfolio-card__tag">{{ item.caption }}</p>
    </div>
    <div class="split__content">
      <p class="eyebrow">{{ theme.galleryTitle }}</p>
      <h2>Uma referência para começar a planejar.</h2>
      <p>{{ theme.galleryText }}</p>
      <p>O atendimento informado inclui <a class="text-link" href="{{ '/regioes-atendidas/joinville/' | url }}">Joinville</a> e <a class="text-link" href="{{ '/regioes-atendidas/araquari/' | url }}">Araquari</a>. O endereço divulgado para retirada fica no Paranaguamirim, em Joinville. A logística para o local da festa é confirmada por endereço e data.</p>
      {% set topicMessage = "Olá, Lela! Vi a página do tema " + theme.name + " e quero consultar a disponibilidade para [data]. Cidade/bairro: [local]." %}
      <div class="button-row">
        <a class="button" href="{{ site.whatsappLink(topicMessage) }}" target="_blank" rel="noopener">Consultar {{ theme.name }} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="{{ '/regioes-atendidas/' | url }}">Ver regiões atendidas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{% if theme.images.length > 1 %}
<section class="section section--lilac">
  <div class="container">
    {% set eyebrow = "Galeria do acervo" %}{% set heading = theme.galleryTitle %}{% set copy = "Abra uma foto para ampliar e consultar esse tema pelo WhatsApp." %}{% include "partials/section-heading.njk" %}
    <div class="portfolio-grid">
      {% for item in theme.images %}
        {% if not loop.first %}{% set hideThemeLink = true %}{% include "partials/portfolio-card.njk" %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container audience-grid">
    <article class="audience-card">
      <p class="eyebrow">Pegue e Monte</p>
      <h2>Consulte porte, montagem e devolução.</h2>
      <p>Veja como funciona o serviço e confirme quais itens do tema podem ser reservados para sua data.</p>
      <a class="text-link" href="{{ '/pegue-e-monte/' | url }}">Como funciona o Pegue e Monte <span aria-hidden="true">→</span></a>
    </article>
    <article class="audience-card">
      <p class="eyebrow">Mini Festa na Mesa</p>
      <h2>Uma opção compacta para celebrar.</h2>
      <p>Consulte se o tema está disponível nesse formato e quais elementos fazem parte da composição.</p>
      <a class="text-link" href="{{ '/mini-festa-na-mesa/' | url }}">Conhecer a Mini Festa na Mesa <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>

<section class="section section--tight section--lilac">
  <div class="container" style="max-width:900px">
    {% set eyebrow = "Perguntas sobre o tema" %}{% set heading = "O que confirmar antes de reservar." %}{% set copy = "As imagens mostram referências do acervo; a disponibilidade depende da data." %}{% include "partials/section-heading.njk" %}
    {% set faqs = theme.faqs %}{% include "partials/faq-list.njk" %}
  </div>
</section>

{% set message = "Olá, Lela! Vi a página do tema " + theme.name + " e quero consultar a disponibilidade para [data]. Cidade/bairro: [local]." %}{% set label = "Consultar esse tema" %}{% include "partials/whatsapp-cta.njk" %}
