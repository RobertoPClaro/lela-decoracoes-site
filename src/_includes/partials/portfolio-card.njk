{% set themePage = themes.byName[item.themeName] %}
{% set lightboxMessage = "Olá, Lela! Vi a foto do tema " + item.themeName + " no portfólio e quero consultar a disponibilidade para [data]." %}
<article class="portfolio-card" data-filter-item data-category="{{ item.category }}" data-source="{{ item.sourceType }}" data-theme="{{ item.slug }}" data-search="{{ item.themeName }} {{ item.categoryLabel }} {{ item.sourceType }}">
  <button class="portfolio-card__button" type="button" data-lightbox-trigger data-theme-name="{{ item.themeName }}" data-lightbox-src="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1200.jpg" data-lightbox-alt="{{ item.alt }}" data-lightbox-caption="{{ item.caption }}" data-lightbox-whatsapp="{{ site.whatsappLink(lightboxMessage) }}" aria-label="Ampliar foto: {{ item.themeName }}">
    <span class="portfolio-card__media">
      {% set imageClass = "portfolio-card__image" %}{% set imageSizes = "(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw" %}{% set imageLoading = "lazy" %}{% set imagePreset = "card" %}{% include "partials/image.njk" %}
      <span class="portfolio-card__zoom" aria-hidden="true">↗</span>
    </span>
  </button>
  <div class="portfolio-card__content">
    <span class="portfolio-card__tag">{{ item.categoryLabel }}</span>
    <h3 class="portfolio-card__title">{% if themePage and not hideThemeLink %}<a href="{{ themePage.path | url }}">{{ item.themeName }}</a>{% else %}{{ item.themeName }}{% endif %}</h3>
  </div>
</article>
