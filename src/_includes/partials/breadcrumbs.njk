{% if breadcrumbs and breadcrumbs.length > 1 %}
  <nav class="breadcrumbs container" aria-label="Você está aqui">
    <ol>
      {% for crumb in breadcrumbs %}
        <li{% if loop.last %} aria-current="page"{% endif %}>
          {% if loop.last %}<span>{{ crumb.label }}</span>{% else %}<a href="{{ crumb.url | url }}">{{ crumb.label }}</a><span aria-hidden="true">/</span>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
