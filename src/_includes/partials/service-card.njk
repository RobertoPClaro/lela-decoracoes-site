<article class="service-card{% if featured %} service-card--featured{% endif %}">
  <div class="service-card__top"><span class="service-card__number">{{ number }}</span><span class="service-card__arrow" aria-hidden="true">↗</span></div>
  <p class="eyebrow">{{ eyebrow }}</p>
  <h3>{{ heading }}</h3>
  <p>{{ copy }}</p>
  <a class="text-link" href="{{ url | url }}">{{ linkLabel or 'Conhecer serviço' }} <span aria-hidden="true">→</span></a>
</article>
