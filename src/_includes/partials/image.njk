{% if imagePreset == 'hero' %}{% set fallbackWidth = '1200' %}{% else %}{% set fallbackWidth = '480' %}{% endif %}
{% if localCatalogContext %}
<picture>
  <source type="image/avif" srcset="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-320.avif 320w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.avif 480w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-768.avif 768w" sizes="{{ imageSizes or '100vw' }}">
  <source type="image/webp" srcset="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-320.webp 320w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.webp 480w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-768.webp 768w" sizes="{{ imageSizes or '100vw' }}">
  <img class="{{ imageClass or '' }}" src="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.jpg" alt="{{ item.alt }}" width="{{ item.width }}" height="{{ item.height }}" loading="{{ imageLoading or 'lazy' }}" decoding="async"{% if imageFetchPriority %} fetchpriority="{{ imageFetchPriority }}"{% endif %}>
</picture>
{% else %}
<picture>
  <source type="image/avif" srcset="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-320.avif 320w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.avif 480w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-768.avif 768w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1200.avif 1200w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1600.avif 1600w" sizes="{{ imageSizes or '100vw' }}">
  <source type="image/webp" srcset="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-320.webp 320w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.webp 480w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-768.webp 768w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1200.webp 1200w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1600.webp 1600w" sizes="{{ imageSizes or '100vw' }}">
  <img class="{{ imageClass or '' }}" src="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-{{ fallbackWidth }}.jpg" srcset="{{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-320.jpg 320w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-480.jpg 480w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-768.jpg 768w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1200.jpg 1200w, {{ site.pathPrefix }}assets/images/generated/{{ item.generatedBase }}-1600.jpg 1600w" sizes="{{ imageSizes or '100vw' }}" alt="{{ item.alt }}" width="{{ item.width }}" height="{{ item.height }}" loading="{{ imageLoading or 'lazy' }}" decoding="async"{% if imageFetchPriority %} fetchpriority="{{ imageFetchPriority }}"{% endif %}>
</picture>
{% endif %}
