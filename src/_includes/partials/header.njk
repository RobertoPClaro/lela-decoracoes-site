<header class="site-header" data-header>
  <div class="container nav-wrap">
    <a class="brand" href="{{ '/' | url }}">
      <img class="brand__logo" src="{{ '/assets/images/reference/763050356_18613920478042020_6619288363067691579_n.jpeg' | url }}" alt="" width="58" height="58">
      <span class="brand__text"><strong>Lela</strong><span>Decorações</span></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <span class="sr-only">Abrir menu</span>
      <span></span><span></span><span></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Navegação principal" data-menu>
      <ul>
        {% for item in site.nav %}
          <li><a href="{{ item.url | url }}"{% if item.url == page.url or (item.url != '/' and page.url.slice(0, item.url.length) == item.url) or (item.url == '/portfolio/' and page.url.slice(0, 7) == '/temas/') %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a class="button button--small button--header" href="{{ site.whatsappLink(globalWhatsAppMessage) }}" data-analytics-placement="header"{% if theme is defined and theme.name %} data-theme-context-whatsapp data-theme-name="{{ theme.name }}" data-theme-slug="{{ theme.slug }}"{% endif %} target="_blank" rel="noopener">Consultar disponibilidade</a>
    </nav>
  </div>
</header>
