<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#7b3f98">
    <meta name="format-detection" content="telephone=no">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    {% if site.baseUrl %}
      <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
      <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">
      <meta property="og:image" content="{{ site.baseUrl }}/assets/images/generated/kit-ursinho-bebe-01-1200.jpg">
    {% endif %}
    <meta property="og:site_name" content="Lela Decorações">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:image:alt" content="Decoração de festa da Lela Decorações">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
    <link rel="describedby" href="{{ '/llms.txt' | url }}">
    <link rel="preload" href="{{ '/assets/css/styles.css' | url }}" as="style">
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
    {% if site.origin %}
      <script type="application/ld+json">{{ site.localBusinessSchema | safe }}</script>
      <script type="application/ld+json">{{ site.breadcrumbSchema(breadcrumbs or [{label: 'Início', url: '/'}]) | safe }}</script>
    {% endif %}
    {% if schemaServiceName %}
      <script type="application/ld+json">{{ site.serviceSchema(schemaServiceName, schemaServiceDescription, page.url, schemaServiceAreas or site.serviceAreaNames) | safe }}</script>
    {% endif %}
    {% if schemaWebPageName %}
      <script type="application/ld+json">{{ site.webPageSchema(schemaWebPageName, schemaWebPageDescription or description, page.url) | safe }}</script>
    {% endif %}
    {% if faqSchema %}
      <script type="application/ld+json">{{ site.faqSchema(schemaFaqs or faqs, page.url) | safe }}</script>
    {% endif %}
  </head>
  <body class="{{ bodyClass or '' }}">
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    {% include "partials/header.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <a class="whatsapp-float" href="{{ site.whatsappLink('Olá, Lela! Quero consultar a disponibilidade de uma decoração.') }}" target="_blank" rel="noopener" aria-label="Falar com a Lela pelo WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.9 11.9 0 0 0 12.04 0C5.47 0 .13 5.34.13 11.91c0 2.1.55 4.15 1.6 5.96L.02 24l6.27-1.65a11.88 11.88 0 0 0 5.75 1.47h.01c6.57 0 11.91-5.34 11.91-11.91 0-3.18-1.24-6.17-3.46-8.41Zm-8.46 18.3h-.01a9.88 9.88 0 0 1-5.03-1.38l-.36-.21-3.72.98.99-3.63-.23-.37a9.88 9.88 0 0 1-1.52-5.28C2.16 6.46 6.59 2.03 12.05 2.03a9.84 9.84 0 0 1 7 2.9 9.84 9.84 0 0 1 2.9 7c0 5.45-4.44 9.87-9.91 9.87Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg>
    </a>
    <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  </body>
</html>
